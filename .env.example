API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
GROUP_ID=your_bridge_group_id
SESSION_NAME=your_session_name

# Optional access control. Leave ADMIN_IDS empty to let anyone use the bot.
# ADMIN_IDS: comma-separated Telegram numeric chat IDs of the bot admin(s),
# e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=
# ADMIN_CONTACT_USERNAME: shown to unauthorized users so they know who to
# contact to request access/subscribe, e.g. @your_admin_username
ADMIN_CONTACT_USERNAME=
