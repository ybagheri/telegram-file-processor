# Separate Telegram API credentials for this QA userbot script.
# Get your own api_id/api_hash at https://my.telegram.org — this MUST be a
# real Telegram USER account's credentials, not the bot's own token, since
# only a user account can send files to a bot and click its buttons the
# same way a real person would.
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION_NAME=qa_userbot_session

# The real bot you want to test against (with or without the leading @).
TARGET_BOT_USERNAME=

# The group/channel where YOU manually upload sample test media (photos,
# videos, mixed archives, etc). The user account above must already be a
# member of this chat. Numeric chat id or @username both work.
TEST_SOURCE_CHAT=
